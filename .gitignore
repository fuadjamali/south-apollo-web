# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything ignored except the .example templates, which are meant to be
# committed so a fresh clone has documented placeholders to copy from.
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# generated identity assets (scripts/generate-identity.js output — review and manually
# promote files out of here, don't commit the staging output itself)
/public/generated/

# typescript
*.tsbuildinfo
next-env.d.ts
