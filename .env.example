# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file containing real secrets.

# Postgres connection string.
# Local dev (matches docker-compose.yml): postgresql://falcon:falcon@localhost:5436/falcon_web
# Production (Vercel Postgres): use the connection string from your Vercel project's Storage tab.
DATABASE_URL=postgresql://falcon:falcon@localhost:5436/falcon_web

# Auth.js (NextAuth) secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Base URL of the app. Local dev: http://localhost:3000. Production: your deployed URL.
NEXTAUTH_URL=http://localhost:3000

# Vercel Blob store token — from the project's Storage tab (Blob store → .env.local tab).
# Auto-populated in Vercel deployments once the store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Secret for signing member login session cookies (separate from admin auth).
# Falls back to NEXTAUTH_SECRET if unset, but set a distinct value in production —
# generate with: openssl rand -base64 32
MEMBER_AUTH_SECRET=

# Pricing tier for this deployment: basic | plus | premium (see lib/plan.js for exactly
# which modules each tier unlocks). Unset defaults to "premium" — every feature enabled.
# Basic: brochure site only (no blog/gallery/news/reviews/partners/team/certifications/
#   multi-theme). Plus: adds all of those. Premium: adds cart/checkout/orders and the
#   member login portal.
PLAN=premium

# Anthropic API key powering the admin panel's "Write with AI" content assistant (Plus/Premium
# plans only — see lib/plan.js). Get one at https://console.anthropic.com. Leave unset to
# disable the feature gracefully (shows a clear error instead of crashing).
ANTHROPIC_API_KEY=

# Optional — only needed for `npm run db:pull-prod` (scripts/pull-prod-db.js), which refreshes
# your local database with a copy of production's on demand. Production's own DATABASE_URL,
# copied from Vercel → Settings → Environment Variables. The script refuses to run unless the
# DATABASE_URL above points at localhost, so this can't accidentally run in reverse.
PROD_DATABASE_URL=
