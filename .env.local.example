# Local development values — copy this file to .env.local.
# .env.local is gitignored and should hold your real local secrets.

DATABASE_URL=postgresql://falcon:falcon@localhost:5436/falcon_web
NEXTAUTH_SECRET=replace-with-a-generated-secret
NEXTAUTH_URL=http://localhost:3000
BLOB_READ_WRITE_TOKEN=replace-with-token-from-vercel-storage-tab
MEMBER_AUTH_SECRET=replace-with-a-generated-secret
PLAN=basic
ANTHROPIC_API_KEY=replace-with-key-from-console.anthropic.com

# Optional — only needed for `npm run db:pull-prod` (scripts/pull-prod-db.js). Production's
# DATABASE_URL, copied from Vercel → Settings → Environment Variables. Never committed; the
# script refuses to run at all if the real DATABASE_URL above isn't pointed at localhost, so
# this can't accidentally overwrite production instead of local.
PROD_DATABASE_URL=
